import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int num=1;
		for(int i=n;i>=1;i--)
		{  
		    // for space
		    for(int j=1;j<=i;j++)
		    {
		       System.out.print(num+" ");
		       num++;
		    }
	
	      System.out.println();
		}
	}
}
